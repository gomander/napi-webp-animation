{
  "name": "napi-webp-animation",
  "version": "0.2.2",
  "description": "A fully typed WebP animation package for NodeJS using Rust",
  "author": "Gunnar Omander <gunnar@gomander.dev> (https://gomander.dev)",
  "license": "MIT",
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "run-p format:toml format:rs",
    "format:js": "oxfmt",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint",
    "check-types": "tsc --noEmit",
    "create-npm-dirs": "napi create-npm-dirs",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node test/main.test.mjs",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@napi-rs/cli": "^3.8.2",
    "@napi-rs/wasm-runtime": "^1.2.2",
    "@taplo/cli": "~0.7.0",
    "@types/node": "^24.13.3",
    "editorconfig": "^3.0.2",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2"
  },
  "napi": {
    "binaryName": "napi-webp-animation",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "default": "./index.js"
    }
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">= 18"
  },
  "repository": {
    "url": "git+ssh://git@github.com/gomander/napi-webp-animation.git",
    "type": "git"
  },
  "homepage": "https://github.com/gomander/napi-webp-animation#readme",
  "bugs": "https://github.com/gomander/napi-webp-animation/issues",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api",
    "webp",
    "webp-animation"
  ],
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
